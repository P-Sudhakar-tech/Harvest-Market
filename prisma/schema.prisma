generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Farmer {
  id          String    @id @default(cuid())
  name        String
  farmName    String
  location    String
  description String
  verified    Boolean   @default(false)
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  pricePaise  Int
  unit        String   @default("kg")
  image       String
  stock       Int      @default(0)
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  farmerId    String
  farmer      Farmer   @relation(fields: [farmerId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([category, active])
  @@index([farmerId])
}

model Order {
  id              String      @id @default(cuid())
  customerName    String
  email           String
  phone           String
  address         String
  deliveryPinCode String
  notes           String?
  subtotalPaise   Int
  deliveryPaise   Int
  totalPaise      Int
  status          String      @default("PENDING_PAYMENT")
  paymentProvider String      @default("manual")
  paymentRef      String?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  @@index([status, createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  productName    String
  quantity       Int
  unitPricePaise Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])
}
