<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Harvest Market</title><link rel="icon" href="/favicon.svg"/></head><body><canvas id="favicon" width="32" height="32"></canvas><script>const c=document.getElementById('favicon');const x=c.getContext('2d');const img=new Image();img.src='/favicon.svg';img.onload=()=>{x.drawImage(img,0,0,32,32);const link=document.querySelector('link[rel="icon"]');link.href=c.toDataURL('image/png');};</script></body></html>
